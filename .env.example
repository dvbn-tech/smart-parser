# Скопировать в .env. Секреты в репозиторий не коммитим.
SP_DATABASE_URL=postgresql+asyncpg://parser:parser@127.0.0.1:5432/parser
SP_REDIS_URL=redis://127.0.0.1:6379/0
SP_S3_ENDPOINT=http://127.0.0.1:9000
SP_S3_BUCKET=smart-parser
SP_S3_ACCESS_KEY=minio
SP_S3_SECRET_KEY=minio12345
# Источник данных: graph — официальный Instagram Graph API (см. docs/META_SETUP.md), web — свои запросы
SP_SOURCE=graph
SP_META_APP_ID=
SP_META_APP_SECRET=
SP_META_ACCESS_TOKEN=
SP_META_IG_USER_ID=
# Шлюз резидентных прокси, sticky-сессия подставляется в {session}
SP_PROXY_URL=
SP_TELEGRAM_BOT_TOKEN=
SP_TELEGRAM_CHAT_ID=
SP_SENTRY_DSN=
